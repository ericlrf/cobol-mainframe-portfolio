//DEFKSDS JOB (ACCT),'DEFINE KSDS',CLASS=A,MSGCLASS=X
//STEP1   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN DD *
  DELETE GBANK.ACCOUNT.KSDS CLUSTER PURGE
  DEFINE CLUSTER (NAME(GBANK.ACCOUNT.KSDS) -
         INDEXED KEYS(14 0) RECORDSIZE(120 120) -
         FREESPACE(10 10) SHAREOPTIONS(2 3)) -
         DATA(NAME(GBANK.ACCOUNT.KSDS.DATA)) -
         INDEX(NAME(GBANK.ACCOUNT.KSDS.INDEX))
/*
