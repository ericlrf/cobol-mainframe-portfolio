//LIMBATCH JOB (ACCT),'LIMIT SETTLEMENT',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//* STEP10 - SORT BY BUSINESS KEY
//SORT10   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=GBANK.MOVEMENTS.DAILY,DISP=SHR
//SORTOUT  DD DSN=GBANK.MOVEMENTS.SORTED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2)),UNIT=SYSDA
//SYSIN    DD *
  SORT FIELDS=(1,20,CH,A)
/*
//* STEP20 - BATCH PROGRAM
//BATCH20  EXEC PGM=LIMBAT01
//STEPLIB  DD DSN=GBANK.LOAD,DISP=SHR
//MOVIN    DD DSN=GBANK.MOVEMENTS.SORTED,DISP=SHR
//SETOUT   DD DSN=GBANK.SETTLEMENT.OUT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2)),UNIT=SYSDA
//SYSOUT   DD SYSOUT=*
//* STEP30 - LISTCAT / VALIDATION EXAMPLE
//IDCAMS30 EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENT(GBANK.ACCOUNT.KSDS) ALL
/*
