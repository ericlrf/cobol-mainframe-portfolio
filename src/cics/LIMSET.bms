* Conceptual BMS map source
LIMSET   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES
LIMMAP   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TITLE    DFHMDF POS=(2,20),LENGTH=32,INITIAL='ACCOUNT LIMIT MAINTENANCE'
AGENCYL  DFHMDF POS=(5,10),LENGTH=8,INITIAL='AGENCY:'
AGENCY   DFHMDF POS=(5,20),LENGTH=4,ATTRB=(UNPROT,IC)
ACCTL    DFHMDF POS=(7,10),LENGTH=8,INITIAL='ACCOUNT:'
ACCOUNT  DFHMDF POS=(7,20),LENGTH=10,ATTRB=UNPROT
LIMITL   DFHMDF POS=(9,10),LENGTH=10,INITIAL='NEW LIMIT:'
NEWLIMIT DFHMDF POS=(9,22),LENGTH=15,ATTRB=UNPROT
MSG      DFHMDF POS=(22,2),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL
         END
